{
  "uid": "logs-loja",
  "title": "Loja — Logs centralizados",
  "tags": [
    "seminario",
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "enable": true,
        "hide": false,
        "iconColor": "#FF9830",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "{service=\"pagamentos\"} |= \"versão alterada\" | json",
        "titleFormat": "Deploy",
        "textFormat": "{{container}}: v{{versao_anterior}} → v{{versao_nova}}",
        "tagKeys": "versao_nova",
        "target": {
          "refId": "Anno",
          "expr": "{service=\"pagamentos\"} |= \"versão alterada\" | json",
          "titleFormat": "Deploy",
          "textFormat": "{{container}}: v{{versao_anterior}} → v{{versao_nova}}",
          "tagKeys": "versao_nova"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "servico",
        "label": "Serviço",
        "type": "custom",
        "query": "gateway,pedidos,estoque,pagamentos",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "gateway",
            "value": "gateway",
            "selected": false
          },
          {
            "text": "pedidos",
            "value": "pedidos",
            "selected": false
          },
          {
            "text": "estoque",
            "value": "estoque",
            "selected": false
          },
          {
            "text": "pagamentos",
            "value": "pagamentos",
            "selected": false
          }
        ]
      },
      {
        "name": "nivel",
        "label": "Nível",
        "type": "custom",
        "query": "info,warn,error",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "warn",
            "value": "warn",
            "selected": false
          },
          {
            "text": "error",
            "value": "error",
            "selected": false
          }
        ]
      },
      {
        "name": "busca",
        "label": "Buscar (user_id, trace_id, pedido...)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Erros (último minuto)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Linhas com level=error em todos os serviços no último minuto. Estado normal: 0. Volta a 0 cerca de 1 min após o rollback.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=~\".+\", level=\"error\"}[1m]))",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Falha no checkout (1 min)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Percentual de checkouts que terminaram em erro 5xx, calculado a partir dos logs do gateway.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "100 * (sum(count_over_time({service=\"gateway\"} |= \"checkout falhou\" [1m])) or vector(0)) / sum(count_over_time({service=\"gateway\"} |= \"checkout iniciado\" [1m]))",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latência p95 do checkout",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Métrica derivada dos logs: campo duracao_ms do log de fim de requisição.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"gateway\"} |= \"requisição concluída\" | json | unwrap duracao_ms | __error__=\"\" [1m]) by (service)",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Volume de logs",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Linhas por segundo ingeridas no Loki (custo!).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({service=~\".+\"}[1m]))",
          "queryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Erros por contêiner",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "Se os erros vêm de uma só réplica, o problema é dessa réplica (deploy, config, máquina).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({service=~\".+\", level=\"error\"}[$__auto]))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Volume de logs por serviço e nível",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "Quantas linhas cada serviço produz, separado por nível.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service, level) (count_over_time({service=~\".+\"}[$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service}} · {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Onde estão os erros (agrupado)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "description": "Uma consulta responde: qual serviço, qual réplica, qual versão e qual exceção.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service, container, version, msg, error_type) (count_over_time({service=~\".+\", level=\"error\"} | json [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "ocorrências",
              "service": "serviço",
              "container": "contêiner",
              "version": "versão",
              "msg": "mensagem",
              "error_type": "exceção"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "ocorrências",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Logs (filtre por usuário, trace_id ou qualquer texto)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 14
      },
      "description": "Clique numa linha e use o link do trace_id para ver a requisição em todos os serviços.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$servico\", level=~\"$nivel\"} |= \"$busca\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      }
    }
  ]
}